<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/playscreen"
    tools:context=".Playscreen">

    <ImageButton
        android:id="@+id/englishbtn"
        android:layout_width="170dp"
        android:layout_height="205dp"
        android:layout_marginTop="132dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/englishbtn" />

    <ImageButton
        android:id="@+id/sciencebtn"
        android:layout_width="170dp"
        android:layout_height="205dp"
        android:layout_marginStart="24dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/englishbtn"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/englishbtn"
        app:layout_constraintTop_toBottomOf="@+id/englishbtn"
        app:layout_constraintVertical_bias="0.034"
        app:srcCompat="@drawable/sciencebtn" />

    <ImageButton
        android:id="@+id/mathbtn"
        android:layout_width="170dp"
        android:layout_height="205dp"
        android:backgroundTint="#00FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/sciencebtn"
        app:layout_constraintEnd_toEndOf="@+id/imageView2"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/imageView2"
        app:layout_constraintTop_toTopOf="@+id/sciencebtn"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/mathbtn" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="168dp"
        android:layout_height="217dp"
        android:layout_marginStart="28dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/englishbtn"
        app:layout_constraintEnd_toStartOf="@+id/englishbtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/englishbtn"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/kidlogo" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="159dp"
        android:layout_height="38dp"
        android:layout_marginTop="112dp"
        android:fontFamily="@font/fredoka_one"
        android:text="Choose Subject"
        android:textColor="#FFFFFF"
        android:textColorHighlight="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/imageView2"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/imageView2"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>