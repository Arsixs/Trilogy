<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".Registerscreen">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profilepic"
        android:layout_width="145dp"
        android:layout_height="128dp"
        android:layout_marginTop="220dp"
        android:scaleType="centerCrop"
        android:src="@drawable/profile_holder"
        app:layout_constraintEnd_toEndOf="@+id/imageView20"
        app:layout_constraintStart_toStartOf="@+id/imageView20"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/fredoka_one"
        android:text="Have an account?"
        android:textColor="#F9E7B7"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/imageButton2"
        app:layout_constraintHorizontal_bias="0.214"
        app:layout_constraintStart_toStartOf="@+id/imageButton2"
        app:layout_constraintTop_toBottomOf="@+id/imageButton2" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/fredoka_one"
        android:text="Login here"
        android:textColor="#81E1FD"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/Loginhere"
        app:layout_constraintEnd_toEndOf="@+id/Loginhere"
        app:layout_constraintStart_toStartOf="@+id/Loginhere"
        app:layout_constraintTop_toTopOf="@+id/Loginhere" />

    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="300dp"
        android:layout_height="91dp"
        android:background="@android:color/transparent"
        android:scaleType="centerCrop"
        android:src="@drawable/registerbtn"
        app:layout_constraintEnd_toEndOf="@+id/password_back"
        app:layout_constraintHorizontal_bias="0.588"
        app:layout_constraintStart_toStartOf="@+id/password_back"
        app:layout_constraintTop_toBottomOf="@+id/imageView19" />

    <ImageView
        android:id="@+id/password_back"
        android:layout_width="337dp"
        android:layout_height="67dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/Password_back"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/Password_back"
        app:layout_constraintTop_toBottomOf="@+id/Password_back"
        app:srcCompat="@drawable/pass" />

    <EditText
        android:id="@+id/confirmpass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Confirm Password"
        android:inputType="text"
        android:textColor="#000000"
        android:textColorHint="#84050505"
        app:layout_constraintBottom_toBottomOf="@+id/password_back"
        app:layout_constraintEnd_toEndOf="@+id/password_back"
        app:layout_constraintHorizontal_bias="0.595"
        app:layout_constraintStart_toStartOf="@+id/password_back"
        app:layout_constraintTop_toTopOf="@+id/password_back"
        app:layout_constraintVertical_bias="0.409" />

    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="341dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/imageView20"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="@+id/imageView20"
        app:layout_constraintTop_toBottomOf="@+id/profilepic"
        app:srcCompat="@drawable/user" />

    <ImageView
        android:id="@+id/Password_back"
        android:layout_width="337dp"
        android:layout_height="67dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/imageView8"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/imageView8"
        app:layout_constraintTop_toBottomOf="@+id/imageView8"
        app:srcCompat="@drawable/pass" />

    <EditText
        android:id="@+id/pass2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Password"
        android:inputType="text"
        android:textColor="#000000"
        android:textColorHint="#84050505"
        app:layout_constraintBottom_toBottomOf="@+id/Password_back"
        app:layout_constraintEnd_toEndOf="@+id/Password_back"
        app:layout_constraintHorizontal_bias="0.58"
        app:layout_constraintStart_toStartOf="@+id/Password_back"
        app:layout_constraintTop_toTopOf="@+id/Password_back"
        app:layout_constraintVertical_bias="0.41000003" />

    <EditText
        android:id="@+id/user2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Username"
        android:inputType="text"
        android:textColor="#000000"
        android:textColorHint="#84050505"
        app:layout_constraintBottom_toBottomOf="@+id/imageView8"
        app:layout_constraintEnd_toEndOf="@+id/imageView8"
        app:layout_constraintHorizontal_bias="0.58"
        app:layout_constraintStart_toStartOf="@+id/imageView8"
        app:layout_constraintTop_toTopOf="@+id/imageView8"
        app:layout_constraintVertical_bias="0.481" />

    <Button
        android:id="@+id/Loginhere"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/textView7"
        app:layout_constraintEnd_toEndOf="@+id/imageButton2"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/textView7"
        app:layout_constraintTop_toTopOf="@+id/textView7" />

    <ImageView
        android:id="@+id/favsub"
        android:layout_width="190dp"
        android:layout_height="57dp"
        android:layout_marginStart="7dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/imageView19"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView19"
        app:layout_constraintTop_toTopOf="@+id/imageView19"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/favbook_input" />

    <ImageView
        android:id="@+id/imageView19"
        android:layout_width="190dp"
        android:layout_height="57dp"
        android:layout_marginTop="4dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toStartOf="@+id/favsub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/password_back"
        app:srcCompat="@drawable/calendar_input" />

    <ImageView
        android:id="@+id/imageView20"
        android:layout_width="202dp"
        android:layout_height="195dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/resgisterlogo" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="71dp"
        tools:layout_editor_absoluteY="539dp" />

    <EditText
        android:id="@+id/Calendar_fill"
        android:layout_width="113dp"
        android:layout_height="43dp"
        android:clickable="true"
        android:ems="10"
        android:hint="Your Birthday"
        android:inputType="text"
        android:textColor="#0B0B0B"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView19"
        app:layout_constraintEnd_toEndOf="@+id/imageView19"
        app:layout_constraintHorizontal_bias="0.67"
        app:layout_constraintStart_toStartOf="@+id/imageView19"
        app:layout_constraintTop_toTopOf="@+id/imageView19"
        app:layout_constraintVertical_bias="0.16000003" />

    <Spinner
        android:id="@+id/favbook_spinner"
        android:layout_width="113dp"
        android:layout_height="43dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@+id/favsub"
        app:layout_constraintEnd_toEndOf="@+id/favsub"
        app:layout_constraintHorizontal_bias="0.688"
        app:layout_constraintStart_toStartOf="@+id/favsub"
        app:layout_constraintTop_toTopOf="@+id/favsub" />

</androidx.constraintlayout.widget.ConstraintLayout>