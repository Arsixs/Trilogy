<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgejimg"
    android:orientation="vertical"
    tools:context=".GameActivity">

    <TextView
        android:id="@+id/time"
        android:layout_width="35dp"
        android:layout_height="14dp"
        android:layout_marginEnd="28dp"
        android:text="99:99"
        android:textAlignment="center"
        android:textColor="#FCFDFD"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/sscore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/sscore"
        app:layout_constraintVertical_bias="0.53" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:max="5"
        android:progress="1"
        app:indicatorColor="#FFC107"
        app:layout_constraintBottom_toTopOf="@+id/lifeText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.436"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.872"
        app:trackColor="#FFECB3"
        app:trackCornerRadius="8dp"
        app:trackThickness="16dp" />

    <TextView
        android:id="@+id/progressText"
        android:layout_width="57dp"
        android:layout_height="47dp"
        android:text="0/5"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:layout_constraintBottom_toTopOf="@+id/img2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.753"
        app:layout_constraintStart_toEndOf="@+id/lifeText"
        app:layout_constraintTop_toBottomOf="@+id/progressBar"
        app:layout_constraintVertical_bias="0.466" />

    <TextView
        android:id="@+id/lifeText"
        android:layout_width="145dp"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:text="❤ ❤ ❤"
        android:textColor="@color/black"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.131"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.29" />

    <ImageView
        android:id="@+id/img1"
        android:layout_width="140dp"
        android:layout_height="128dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/img2"
        app:layout_constraintHorizontal_bias="0.45"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.469"
        tools:src="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/img2"
        android:layout_width="140dp"
        android:layout_height="128dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="40dp"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.469" />

    <EditText
        android:id="@+id/answerInput"
        android:layout_width="274dp"
        android:layout_height="60dp"
        android:layout_marginBottom="4dp"
        android:hint="Input Answer"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textColorHint="#8A8686"
        android:textSize="24sp"
        android:typeface="serif"
        app:layout_constraintBottom_toTopOf="@+id/submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img1" />

    <Button
        android:id="@+id/submit"
        android:layout_width="193dp"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        android:onClick="submit"
        android:text="Submit"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answerInput" />

    <TextView
        android:id="@+id/sscore"
        android:layout_width="35dp"
        android:layout_height="19dp"
        android:layout_marginStart="44dp"
        android:text="0"
        android:textAlignment="center"
        android:textColor="#3F51B5"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/lifeText"
        app:layout_constraintEnd_toStartOf="@+id/time"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.362" />

    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/timerGif"
        android:layout_width="217dp"
        android:layout_height="188dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/answerInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/tenseconds"
        android:src="@drawable/tenseconds"/>

</androidx.constraintlayout.widget.ConstraintLayout>